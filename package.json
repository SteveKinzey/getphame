  "name": "get-phame",
  "displayName": "Get Phame",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development tsx watch server/_core/index.ts",
    "audit:prod": "node scripts/audit-prod.mjs",
    "build": "pnpm audit:prod && pnpm test && vite build && esbuild server/_core/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "check": "pnpm check:client && pnpm check:server",
    "check:client": "tsc -p tsconfig.client.json --noEmit",
    "check:server": "tsc -p tsconfig.server.json --noEmit",
    "check:router-contracts": "tsc --noEmit --incremental false",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:push": "drizzle-kit generate && drizzle-kit migrate"
  },
